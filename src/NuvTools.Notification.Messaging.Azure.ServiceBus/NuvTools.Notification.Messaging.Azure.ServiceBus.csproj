<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8;net9;net10.0</TargetFrameworks>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Authors>Nuv Tools</Authors>
		<Copyright>Copyright © 2026 Nuv Tools</Copyright>
		<PackageProjectUrl>https://nuvtools.com</PackageProjectUrl>
		<Description>Azure Service Bus implementation for NuvTools.Notification.Messaging. Includes AzureServiceBusSender for publishing messages and AzureServiceBusReceiver as a background service for consuming messages with automatic deserialization, dead-lettering, retry logic, and concurrent processing support.</Description>
		<Version>10.2.14</Version>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<PackageIcon>icon.png</PackageIcon>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<RepositoryUrl>https://github.com/nuvtools/nuvtools-notification</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<AnalysisLevel>latest</AnalysisLevel>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>NuvTools;Azure;ServiceBus;Messaging;Queue;Topic;Subscription;Cloud;PubSub;BackgroundService;Dead-Letter;ManagedIdentity;Passwordless;Microservices;dotnet</PackageTags>
		<ImplicitUsings>true</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- SourceLink: a stack trace from a consumer's process steps into the exact commit this
		     package was built from. EmbedUntrackedSources covers the generated files, which are the
		     ones a debugger otherwise cannot find. The .NET 8+ SDK has SourceLink built in, so no
		     package reference is needed. -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<!-- Set by the publish workflow. Makes the build deterministic and marks the package as built by
	     CI rather than on somebody's machine. -->
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\icon.png">
			<Link>icon.png</Link>
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\..\LICENSE">
			<Link>LICENSE</Link>
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
		<PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
		<!-- Azure.Core 1.60+ carries the Azure.Identity credential types (DefaultAzureCredential);
		     referencing Azure.Identity as well makes those types ambiguous. -->
		<PackageReference Include="Azure.Core" Version="1.63.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NuvTools.Notification.Messaging\NuvTools.Notification.Messaging.csproj" />
	</ItemGroup>

</Project>
